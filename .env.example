# Sectors Financial API v2 key (Insider plan): https://sectors.app/api
SECTORS_API_KEY=

# OpenAI API key for the analyst chat: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any Responses API model. gpt-6-astra is the most capable, gpt-5.6-luna the cheapest.
OPENAI_MODEL=gpt-5.6-terra
# none | minimal | low | medium | high. Lower is faster and cheaper.
OPENAI_REASONING_EFFORT=low

# Folder holding the broker summary export (parquet/, meta/). Relative to this app.
BROKSUM_DIR=../broksum-data
# Last date the local broker data is complete for every stock. Later days come from Sectors.
BROKSUM_LAST_COMPLETE=2026-09-10
