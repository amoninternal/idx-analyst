# Where API keys come from.
#   (unset)  Visitors connect their own Sectors and Gemini keys on /connect. The keys below are
#            ignored, so a public deployment can never spend yours. This is the default.
#   server   You run the app for yourself with the keys below.
# Uncomment only on your own machine. Never set KEY_MODE=server on a public deployment.
# KEY_MODE=server

# Encrypts visitors' key sessions. Required unless KEY_MODE=server. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Set to 1 only behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For, so the
# connect page's attempt limiter can tell visitors apart. Automatic on Vercel.
# TRUST_PROXY_HEADERS=1

# Used only when KEY_MODE=server.
# Sectors Financial API v2 key (Insider plan): https://sectors.app/api
SECTORS_API_KEY=
# Gemini API key for the analyst chat: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The analyst's model. gemini-3.8-flash is the recommended default; gemini-3.5-flash-lite is cheaper,
# gemini-3.1-pro-preview the most capable.
GEMINI_MODEL=gemini-3.8-flash
# minimal | low | medium | high. Lower is faster and cheaper.
GEMINI_THINKING_LEVEL=low

# Folder holding the broker summary export (parquet/, meta/). Relative to this app.
BROKSUM_DIR=../broksum-data
# Last date the local broker data is complete for every stock. Later days come from Sectors.
# With no local export, set a past date (e.g. 2020-01-01) so all broker data comes from Sectors.
BROKSUM_LAST_COMPLETE=2026-09-10
